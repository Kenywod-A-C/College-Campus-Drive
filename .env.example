# Frontend environment (copy to .env.local). Only VITE_* variables reach the browser: never put secrets here.

# 'true' = use the in-browser MOCK backend (development only, fictional data, fake login).
# anything else = talk to the real Flask API.
VITE_USE_MOCK=false

# Base URL of the REST API. Keep the default to use the Vite dev proxy (same origin, so the httpOnly refresh cookie works).
VITE_API_BASE_URL=/api/v1

# Where the Vite dev server proxies /api to (the Flask server).
VITE_DEV_PROXY_TARGET=http://127.0.0.1:5000
