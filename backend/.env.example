# Backend environment. Copy to backend/.env (git-ignored) and fill in. Real environment variables always win over this file.
# NEVER commit real values.

APP_ENV=development                # development | testing | production

# SQLAlchemy URL. MySQL 8 / MariaDB 10.6+ via the pure-Python PyMySQL driver.
DATABASE_URL=mysql+pymysql://campus_app:CHANGE_ME@127.0.0.1:3306/campus_assistant?charset=utf8mb4

# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(48))"   (production requires >= 32 chars)
SECRET_KEY=
JWT_SECRET_KEY=

# Browser-facing URL of the SPA (used to build password-reset links).
FRONTEND_URL=http://localhost:5173
# Comma-separated origins allowed for cross-origin calls. Leave empty when the SPA is served same-origin
# (the Vite dev proxy and a reverse proxy in production both are).
CORS_ORIGINS=

# Cookies for the httpOnly refresh token. COOKIE_SECURE must be true behind HTTPS (the production default).
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# Brute-force protection
LOGIN_RATE_LIMIT=10 per minute
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
# In production use a shared store, e.g. redis://localhost:6379/0 (memory:// is per-process and refused in production)
RATELIMIT_STORAGE_URI=memory://

# ---- AI assistant (LLM). The key stays on the server: it is never sent to the browser, the prompt or a log.
# With no usable settings the assistant reports itself as "not configured" (HTTP 503); there are no canned answers.
# Pick ONE provider (any LLM service works through one of two official SDKs):
#   anthropic          Claude models                          LLM_MODEL defaults to claude-opus-5-5
#   openai             OpenAI                                 e.g. LLM_MODEL=gpt-4o-mini
#   gemini | mistral | groq | deepseek | openrouter | together     preset endpoints; set LLM_MODEL to that service's model name
#   ollama             local models, no key needed            e.g. LLM_MODEL=llama3.1
#   openai_compatible  any other OpenAI-protocol server       needs LLM_BASE_URL (vLLM, LM Studio, a company gateway, ...)
# Put each value on its own line, no quotes. NEVER put a real key in this example file: use backend/.env (git-ignored).
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=
#LLM_BASE_URL=                      # optional endpoint override for any provider
#LLM_EFFORT=                        # optional: anthropic low|medium|high|xhigh|max; openai-protocol: reasoning_effort (reasoning models only)
LLM_TIMEOUT_SECONDS=45              # per model request
LLM_MAX_RETRIES=1                   # SDK retries on 429/5xx/connection errors
LLM_MAX_OUTPUT_TOKENS=4000          # per model call
ASSISTANT_MAX_INPUT_CHARS=2000      # longest user message
ASSISTANT_TURN_SECONDS=90           # wall-clock budget for one chat turn (all model calls + tools). Set the WSGI timeout above this (gunicorn --timeout 120)
ASSISTANT_MAX_TOOL_ROUNDS=5
ASSISTANT_HISTORY_MESSAGES=20       # earlier messages replayed to the model
ASSISTANT_MAX_MESSAGES_PER_CONVERSATION=200
ASSISTANT_ACTION_TTL_MINUTES=60     # a proposed action expires if the user does not confirm in time
ASSISTANT_RETENTION_DAYS=30         # deleted conversations are purged after this (flask assistant-purge, run it daily)
ASSISTANT_CHAT_RATE_LIMIT=12 per minute;200 per day   # per signed-in user

# Local demo data only (flask seed-demo). One password for every demo account; refused when APP_ENV=production.
SEED_DEMO_PASSWORD=

# Optional: run the test-suite against a real MySQL/MariaDB database instead of in-memory SQLite.
# WARNING: every table in that database is dropped between tests. Use a throwaway database.
TEST_DATABASE_URL=
